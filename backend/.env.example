PORT=5000
# Allowed website addresses, separated by commas, with no trailing slash.
# Example for production: https://your-app.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
# Set TRUST_PROXY=1 when the server runs behind a host such as Render or Railway.
# TRUST_PROXY=1

# ---- Threat-list sources. Set any that you have. Missing ones are skipped. ----

# Google Safe Browsing: free, NON-COMMERCIAL use only.
# Console: enable "Safe Browsing API", create a key, restrict it to that API.
SAFE_BROWSING_API_KEY=

# Google Web Risk: the commercial version. Use this once PhishCheck earns money.
# The first 100,000 lookups per month are free but a billing account is required.
WEBRISK_API_KEY=

# URLhaus (abuse.ch): malware links only. Free key from the abuse.ch
# Authentication Portal. Fair use / non-commercial.
URLHAUS_AUTH_KEY=

# OpenPhish community feed: phishing links, refreshed every 12 hours.
# NON-COMMERCIAL use only. Leave false if you ever sell PhishCheck.
ENABLE_OPENPHISH=false

# ---- Team training (optional) ----
# Create a free project at supabase.com, run sql/team_training.sql in its SQL
# Editor, then add the project URL and a SECRET key here. Never expose the
# secret key in the frontend or on GitHub.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
